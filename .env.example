# Backend (all optional for local dev)
WP_CORS_ORIGINS=http://localhost:5173
# Optional AI providers. Without these, deterministic fallbacks are used.
ANTHROPIC_API_KEY=
# Or Claude on Microsoft Foundry (scripts/azure-foundry-setup.sh); WP_LLM_MODEL is then the deployment name
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
WP_LLM_MODEL=claude-haiku-5-5
# Optional voice/video (LiveKit). docker compose --profile voice up
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_that_is_at_least_32_chars_long
# Optional catalogue enrichment
TMDB_API_KEY=
# Optional GIFs and stickers in chat (developers.giphy.com). Kept server-side only
GIPHY_API_KEY=
# Party lifecycle (defaults shown)
WP_MAX_PARTICIPANTS=20
WP_IDLE_ROOM_MINUTES=30
WP_ROOM_MAX_AGE_HOURS=12
# Forget members who have been gone this long (0 = keep everyone until the room ends)
WP_PRUNE_MEMBER_HOURS=4
# Where Discover recommendations are saved (recs.json). Defaults to backend/var
WP_DATA_DIR=
